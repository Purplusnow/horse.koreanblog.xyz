{
  "name": "{{ site.name }}",
  "short_name": "{{ site.short_name }}",
  "description": "{{ site.description }}",
  "lang": "{{ site.lang }}",
  "dir": "ltr",
  "start_url": "/?src=pwa",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "{{ theme_color }}",
  "categories": ["sports", "news"],
  "icons": [
    { "src": "/static/icon-192.png?v={{ assets['icon-192.png'] }}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icon-512.png?v={{ assets['icon-512.png'] }}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icon-maskable-512.png?v={{ assets['icon-maskable-512.png'] }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "오늘의 예상", "url": "/?src=pwa_shortcut" },
    { "name": "지난 결과", "url": "/results/?src=pwa_shortcut" },
    { "name": "적중률", "url": "/accuracy/?src=pwa_shortcut" }
  ]
}
